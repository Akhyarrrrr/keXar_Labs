---
import StudioLayout from '@/layouts/StudioLayout.astro';
import HQContactBand from '@/components/HQContactBand.astro';
import HQArrow from '@/components/HQArrow.astro';
import { services } from '@/lib/content';
import { servicePath, localePaths } from '@/lib/routes';
export const getStaticPaths = localePaths;
if (Astro.props.locale === 'id') return Astro.redirect('/en/services/', 308);
---

<StudioLayout
  title="Services"
  description="Websites, web applications and practical automation. Explore what keXar Labs can build for your business."
  path="services/"
>
  <section class="hq-page-head">
    <h1>What does your business need next?</h1><div>
      <p>
        A clearer business presence. A system for your team. A workflow with fewer repeated steps.
        We define the requirements together, then design and build around them.
      </p><div class="hq-actions">
        <a class="hq-button" href="/en/contact/">Discuss your project <HQArrow /></a>
      </div>
    </div>
  </section>
  <figure class="hq-page-image">
    <img
      src="/media/headquarters/posters/capabilities-desktop.webp"
      alt="Three connected software workspaces in the conceptual headquarters"
      width="2560"
      height="1600"
    /><figcaption>
      <span>Connected capabilities, shaped around the brief.</span><span
        >Conceptual digital environment</span>
    </figcaption>
  </figure>
  <section class="hq-section">
    {
      services.en.slice(0, 3).map((service) => (
        <article class="hq-capability-row">
          <>
            <h2>{service.title}</h2>
            <div>
              <>
                <p>{service.intro}</p>
                <a href={`/en/services/${servicePath(service.id)}/`}>
                  Explore the service <HQArrow />
                </a>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <section class="hq-section">
    <div class="hq-section-intro">
      <h2>Supporting the whole project.</h2><p>
        These services can be part of a wider engagement or a focused project of their own. We
        review the current setup before agreeing on the work.
      </p>
    </div>{
      services.en.slice(3).map((service) => (
        <article class="hq-capability-row">
          <>
            <h2>{service.title}</h2>
            <div>
              <>
                <p>{service.intro}</p>
                <a href={`/en/services/${servicePath(service.id)}/`}>
                  Explore the service <HQArrow />
                </a>
              </>
            </div>
          </>
        </article>
      ))
    }
  </section>
  <HQContactBand />
</StudioLayout>
