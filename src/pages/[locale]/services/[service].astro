---
import StudioLayout from '@/layouts/StudioLayout.astro';
import HQContactBand from '@/components/HQContactBand.astro';
import HQArrow from '@/components/HQArrow.astro';
import { services, locales } from '@/lib/content';
import { servicePath } from '@/lib/routes';
export function getStaticPaths() {
  return locales.flatMap((locale) =>
    services.en.flatMap((service) =>
      [...new Set([service.id, servicePath(service.id)])].map((slug) => ({
        params: { locale, service: slug },
        props: { locale, service },
      })),
    ),
  );
}
const { locale, service } = Astro.props;
if (locale === 'id' || Astro.params.service === 'legal-web')
  return Astro.redirect(`/en/services/${servicePath(service.id)}/`, 308);
const room =
  service.id === 'ai' || service.id === 'web-app'
    ? 'delivery'
    : service.id === 'server'
      ? 'process'
      : 'capabilities';
---

<StudioLayout
  title={service.title}
  description={service.intro}
  path={`services/${servicePath(service.id)}/`}
>
  <section class="hq-page-head">
    <div><a class="hq-link" href="/en/services/">All services</a><h1>{service.title}</h1></div><div>
      <p>{service.intro}</p><div class="hq-actions">
        <a class="hq-button" href={`/en/contact/?service=${service.id}`}
          >Discuss your project <HQArrow /></a>
      </div>
    </div>
  </section>
  <figure class="hq-page-image">
    <img
      src={`/media/headquarters/posters/${room}-desktop.webp`}
      alt=""
      width="2560"
      height="1600"
    /><figcaption>
      <span>{service.short}</span><span>Conceptual digital environment</span>
    </figcaption>
  </figure>
  <section class="hq-section hq-details">
    <div>
      <h2>What we can help with</h2><ul>{service.needs.map((item) => <li>{item}</li>)}</ul>
    </div><div>
      <h2>What the work includes</h2><ul>{service.deliverables.map((item) => <li>{item}</li>)}</ul>
    </div>
  </section>
  <section class="hq-section hq-example">
    <h2>An example in practice</h2><p>{service.example}</p>
  </section>
  <section class="hq-section">
    <p>
      Scope, technology, pricing and timing are agreed after the brief. Editing, hosting, external
      service fees and ongoing support are included only when stated in the proposal.
    </p>
  </section>
  <HQContactBand />
</StudioLayout>
