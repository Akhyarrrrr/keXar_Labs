---
import StudioLayout from '@/layouts/StudioLayout.astro';
import { copy } from '@/lib/content';
import { localePaths } from '@/lib/routes';
export const getStaticPaths = localePaths;
if (Astro.props.locale === 'id') return Astro.redirect('/en/privacy/', 308);
---

<StudioLayout
  title="Privacy"
  description="How information moves through the keXar Labs website and project brief form."
  path="privacy/"
>
  <section class="hq-page-head">
    <h1>Privacy, in clear language.</h1><p>
      This page explains how information moves through the website. Brief delivery is available only
      after the studio’s contact services are configured and tested.
    </p>
  </section>
  <section class="hq-reading">
    {
      copy.en.privacySections.map(([title, description]) => (
        <article>
          <>
            <h2>{title}</h2>
            <p>{description}</p>
          </>
        </article>
      ))
    }<a class="hq-link" href="/en/contact/">Return to the project brief</a>
  </section>
</StudioLayout>
