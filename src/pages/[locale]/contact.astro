---
import StudioLayout from '@/layouts/StudioLayout.astro';
import { ContactForm } from '@/components/contact-form';
import { copy, publicConfig, whatsappUrl } from '@/lib/content';
import HQArrow from '@/components/HQArrow.astro';
import { localePaths } from '@/lib/routes';
export const getStaticPaths = localePaths;
if (Astro.props.locale === 'id') return Astro.redirect('/en/contact/', 308);
---

<StudioLayout
  title="Discuss your project"
  description="Tell keXar Labs what your business needs to build, improve or simplify. Start with a clear project brief."
  path="contact/"
>
  <section class="hq-page-head">
    <h1>Tell us what you want to build.</h1><p>
      Share what your business does, what you need, and what you would like to improve. We can use
      that brief to discuss the next step.
    </p>
  </section>
  <section class="hq-contact-page">
    <aside>
      <h2>A useful starting point.</h2><p>
        The proposal follows your requirements. Your initial brief can cover:
      </p><ul>
        <li>Your business and the people the project serves.</li><li>
          What you want to build, improve or simplify.
        </li><li>Existing materials, integrations and editing needs.</li>
      </ul><p>
        Please leave passwords, private documents and sensitive personal data out of the brief.
      </p><a class="hq-link" href="/en/privacy/">How your information is used <HQArrow /></a>{
        publicConfig.email && (
          <a class="hq-link" href={`mailto:${publicConfig.email}`}>
            {copy.en.form.emailLink}
            <HQArrow />
          </a>
        )
      }{
        publicConfig.whatsapp && (
          <a class="hq-link" href={whatsappUrl()} target="_blank" rel="noopener noreferrer">
            Continue on WhatsApp
            <HQArrow />
          </a>
        )
      }
    </aside><div>
      <ContactForm client:load /><noscript
        ><p class="hq-nojs">
          The form requires JavaScript for security verification. {
            publicConfig.email ? (
              <a href={`mailto:${publicConfig.email}`}>Contact the studio by email.</a>
            ) : (
              'Delivery will become available after the studio inbox is configured and tested.'
            )
          }
        </p></noscript>
    </div>
  </section>
</StudioLayout>
