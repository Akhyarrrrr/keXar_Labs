---
import StudioLayout from '@/layouts/StudioLayout.astro';
import Headquarters from '@/components/Headquarters.astro';
import { copy } from '@/lib/content';
import { localePaths } from '@/lib/routes';
export const getStaticPaths = localePaths;
const { locale } = Astro.props;
if (locale === 'id') return Astro.redirect('/en/', 308);
---

<StudioLayout title={copy.en.headline} description={copy.en.heroNote}>
  <Headquarters />
</StudioLayout>
