---
import { pageMeta } from "@/lib/seo";
import Header from "@/components/Header.astro";
import "@/styles/landing.css";
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
  immersive?: boolean;
}
const {
  title,
  description,
  path = "",
  noindex = false,
  immersive = false,
} = Astro.props;
const meta = pageMeta(title, description, path);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#202729" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && meta.canonical && (
      <link rel="canonical" href={meta.canonical} />
    )}
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="keXar Labs" />
    <meta property="og:type" content="website" />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/mona-sans.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    {immersive && (
      <>
        <link
          rel="preload"
          href="/images/city-interior.jpg"
          as="image"
          media="(max-width: 900px)"
        />
        <link
          rel="preload"
          href="/images/city-interior-hd.webp"
          as="image"
          media="(min-width: 901px)"
        />
        <script is:inline>
          document.documentElement.classList.add("is-loading");
          window.kexarLoadingFallback = setTimeout(() => {
            document.documentElement.classList.remove("is-loading");
            const loader = document.querySelector(".preloader");
            if (loader) loader.hidden = true;
            document.querySelectorAll("main,.site-nav").forEach((element) => {
              element.inert = false;
            });
          }, 15000);
        </script>
        <noscript>
          <style>
            .preloader {
              display: none !important;
            }
          </style>
        </noscript>
      </>
    )}
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      Skip to content
    </a>
    <Header solid={!immersive} />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
