---
import { pageMeta } from '@/lib/seo';
import '@/styles/headquarters.css';
interface Props {
  title: string;
  description: string;
  path?: string;
  noindex?: boolean;
}
const { title, description, path = '', noindex = false } = Astro.props;
const meta = pageMeta('en', title, description, path);
const navigation = [
  ['Services', 'services/', 'capabilities'],
  ['Showcase', 'showcase/', 'showcase'],
  ['Studio', 'studio/', 'lobby'],
  ['Contact', 'contact/', 'conversation'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title><meta name="description" content={description} /><meta
      name="theme-color"
      content="#f3ede6"
    /><meta name="color-scheme" content="light" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!noindex && meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {
      !noindex &&
        meta.alternates.map(({ lang, href }) => (
          <link rel="alternate" hreflang={lang} href={href} />
        ))
    }
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:site_name" content="keXar Labs" /><meta
      property="og:type"
      content="website"
    /><meta property="og:locale" content="en_US" />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    {
      meta.image && (
        <>
          <>
            <meta property="og:image" content={meta.image} />
            <meta property="og:image:width" content="1200" />
            <meta property="og:image:height" content="630" />
            <meta
              property="og:image:alt"
              content="keXar Labs — websites and systems built around your business"
            />
          </>
        </>
      )
    }
    <meta name="twitter:card" content="summary_large_image" /><meta
      name="twitter:title"
      content={title}
    /><meta name="twitter:description" content={description} />{
      meta.image && <meta name="twitter:image" content={meta.image} />
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link
      rel="icon"
      href="/brand/favicon-32.png"
      sizes="32x32"
      type="image/png"
    />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
    {
      path === '' && (
        <link
          rel="preload"
          as="image"
          href="/media/headquarters/posters/arrival-mobile.webp"
          media="(max-width: 700px)"
          fetchpriority="high"
        />
      )
    }
  </head>
  <body class="hq-site" data-page={path || 'home'}>
    <a href="#main-content" class="hq-skip">Skip to content</a>
    <header class="hq-header">
      <a class="hq-brand" href="/en/" aria-label="keXar Labs home"
        ><img src="/brand/wordmark-positive.svg" alt="keXar Labs" width="589" height="130" /></a
      >
      <details class="hq-menu" open>
        <summary>Menu</summary><nav aria-label="Main navigation">
          {
            navigation.map(([label, route, anchor]) => (
              <a
                href={path === '' ? `#${anchor}` : `/en/${route}`}
                aria-current={path.startsWith(route) ? 'page' : undefined}
              >
                {label}
              </a>
            ))
          }
        </nav>
      </details>
    </header>
    <main id="main-content" tabindex="-1"><slot /></main>
    <footer class="hq-footer">
      <div class="hq-footer-top">
        <div>
          <a href="/en/" aria-label="keXar Labs home"
            ><img
              src="/brand/wordmark-positive.svg"
              alt="keXar Labs"
              width="589"
              height="130"
              loading="lazy"
            /></a
          ><p>Websites, applications and practical automation built around your business.</p>
        </div><nav aria-label="Explore keXar Labs">
          {navigation.map(([label, route]) => <a href={`/en/${route}`}>{label}</a>)}
        </nav>
      </div>
      <div class="hq-footer-bottom">
        <span>© {new Date().getFullYear()} keXar Labs</span><p>
          The headquarters is a conceptual digital environment.
        </p><a href="/en/privacy/">Privacy</a><a href="#main-content">Back to top</a>
      </div>
    </footer>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.hq-menu');
      const mobile = matchMedia('(max-width: 700px)');
      if (menu) menu.open = !mobile.matches;
      mobile.addEventListener('change', () => {
        if (menu) menu.open = !mobile.matches;
      });
      menu?.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mobile.matches) {
          menu.open = false;
          menu.querySelector('summary')?.focus();
        }
      });
      menu?.querySelectorAll('a').forEach((link) =>
        link.addEventListener('click', () => {
          if (mobile.matches) menu.open = false;
        }),
      );
    </script>
  </body>
</html>
