---
import { copy, type Locale } from '@/lib/content';
import { pageMeta } from '@/lib/seo';
import Wordmark from '@/components/Wordmark.astro';
import '@/styles/global.css';
import '@/styles/components.css';
interface Props {
  locale: Locale;
  title: string;
  description: string;
  path?: string;
}
const { locale, title, description, path = '' } = Astro.props;
const t = copy[locale];
const meta = pageMeta(locale, title, description, path);
const other = locale === 'id' ? 'en' : 'id';
const navPaths = ['services/', 'showcase/', 'studio/', 'contact/'];
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{meta.title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#F7F6F2" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          preference = localStorage.getItem('kexar-theme') || 'system';
        } catch {}
        const theme =
          preference === 'dark' ||
          (preference !== 'light' && matchMedia('(prefers-color-scheme: dark)').matches)
            ? 'dark'
            : 'light';
        document.documentElement.dataset.theme = theme;
        document.documentElement.style.colorScheme = theme;
        document.querySelector('meta[name="theme-color"]').content =
          theme === 'dark' ? '#0B0D10' : '#F7F6F2';
      })();
    </script>
    {path === '' && <script is:inline>
      (() => {
        const theme = document.documentElement.dataset.theme;
        const width = innerWidth <= 800 ? 800 : 1600;
        const photo = `/images/hero-${theme}-${width}.webp`;
        document.documentElement.style.setProperty('--hero-image', `url("${photo}")`);
        const preload = document.createElement('link');
        preload.rel = 'preload';
        preload.as = 'image';
        preload.href = photo;
        preload.fetchPriority = 'high';
        document.head.append(preload);
      })();
    </script>}
    {meta.canonical && <link rel="canonical" href={meta.canonical} />}
    {meta.alternates.map(({ lang, href }) => (
      <link rel="alternate" hreflang={lang} href={href} />
    ))}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="keXar Labs" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={locale === 'id' ? 'id_ID' : 'en_US'} />
    {meta.canonical && <meta property="og:url" content={meta.canonical} />}
    {meta.image && (
      <>
        <meta property="og:image" content={meta.image} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content="keXar Labs" />
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {meta.image && <meta name="twitter:image" content={meta.image} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/cormorantgaramond.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="preload" href="/fonts/manrope.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main-content" class="skip-link">
      {locale === 'id' ? 'Lewati ke konten' : 'Skip to content'}
    </a>
    <header class="site-header">
      <a class="brand-link" href={`/${locale}/`} aria-label="keXar Labs">
        <Wordmark />
      </a>
      <nav
        id="main-nav"
        class="header-nav"
        aria-label={locale === 'id' ? 'Navigasi utama' : 'Main navigation'}
      >
        {navPaths.map((href, i) => (
          <a href={`/${locale}/${href}`} aria-current={path.startsWith(href) ? 'page' : undefined}>
            {t.nav[i]}
          </a>
        ))}
      </nav>
      <div class="header-controls">
        <label class="theme-control">
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="8" />
            <path d="M12 4v16M12 4a8 8 0 0 1 0 16" fill="currentColor" />
          </svg>
          <span class="sr-only">{locale === 'id' ? 'Tema tampilan' : 'Appearance'}</span>
          <select data-theme-control aria-label={locale === 'id' ? 'Tema tampilan' : 'Appearance'}>
            <option value="system">{locale === 'id' ? 'Sistem' : 'System'}</option>
            <option value="light">{locale === 'id' ? 'Terang' : 'Light'}</option>
            <option value="dark">{locale === 'id' ? 'Gelap' : 'Dark'}</option>
          </select>
        </label>
        <a
          class="language-link"
          data-language
          href={`/${other}/${path}`}
          lang={other}
          aria-label={
            other === 'en'
              ? 'EN — Read this page in English'
              : 'ID — Baca halaman ini dalam bahasa Indonesia'
          }
        >
          {other.toUpperCase()}
        </a>
        <a class="header-talk" href={`/${locale}/contact/`}>
          {locale === 'id' ? 'Mulai percakapan' : 'Start a conversation'}
          <svg
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M6 18 18 6M6 6h12v12" />
          </svg>
        </a>
        <button class="menu-toggle" aria-controls="main-nav" aria-expanded="false">
          <span>{t.menu}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M3 7h14M3 13h14" fill="none" stroke="currentColor" stroke-width="1.5" />
          </svg>
        </button>
      </div>
    </header>
    <main id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="footer-top">
        <a href={`/${locale}/`} aria-label="keXar Labs">
          <Wordmark large />
        </a>
        <p>{t.footerNote}</p>
      </div>
      <div class="footer-bottom">
        <span>© {new Date().getFullYear()} keXar Labs</span>
        <div>
          <a href={`/${locale}/studio/`}>{t.nav[2]}</a>
          <a href={`/${locale}/privacy/`}>{t.privacy}</a>
          <a href={`/${locale}/contact/`}>{t.nav[3]}</a>
        </div>
        <span>{locale === 'id' ? 'Dibangun dengan perhatian.' : 'Built with care.'}</span>
      </div>
    </footer>
    <script>
      import { initStudio } from '@/scripts/studio';
      initStudio();
    </script>
  </body>
</html>
