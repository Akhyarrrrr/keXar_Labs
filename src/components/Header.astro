---
import Arrow from "./Arrow.astro";
interface Props {
  solid?: boolean;
}
const { solid = false } = Astro.props;
---

<header class:list={["site-nav", { "is-scrolled": solid }]}>
  <a class="brand" href="/#top" aria-label="keXar Labs home">
    ke<span>X</span>ar <small>Labs</small>
  </a>
  <nav aria-label="Main navigation">
    <a href="/#work">Selected work</a>
    <a href="/#scope">What we build</a>
    <a href="/#approach">How we work</a>
  </nav>
  <details class="nav-menu">
    <summary>
      Menu <span aria-hidden="true">+</span>
    </summary>
    <nav aria-label="Mobile navigation">
      <a href="/#work">Selected work</a>
      <a href="/#scope">What we build</a>
      <a href="/#approach">How we work</a>
    </nav>
  </details>
  <a class="nav-contact" href="/#contact">
    <span class="nav-contact-label">Start a project</span>
    <span class="nav-contact-arrow" aria-hidden="true">
      <Arrow />
    </span>
  </a>
</header>
