---
import type { Locale } from '@/lib/content';
import { demoLabels, type ConceptId, type DemoContent } from '@/lib/demos';
import DemoImage from './DemoImage.astro';
import { ArrowUpRightIcon } from '@phosphor-icons/react/dist/ssr';
interface Props {
  locale: Locale;
  concept: ConceptId;
  content: DemoContent;
  kind: 'practices' | 'people' | 'insights';
}
const { locale, concept, content, kind } = Astro.props;
const t = demoLabels[locale],
  base = `/${locale}/demo/${concept}/`;
---

<section class="legal-page-heading">
  <nav class="legal-breadcrumb" aria-label={locale === 'id' ? 'Jejak navigasi' : 'Breadcrumb'}>
    <a href={base}>{t.home}</a>
    <span aria-hidden="true">/</span>
    <span aria-current="page">{t[kind]}</span>
  </nav>
  <h1>{t[kind]}</h1>
  <p>
    {kind === 'practices'
      ? content.statementNote
      : kind === 'people'
        ? locale === 'id'
          ? 'Profil fiktif yang menunjukkan kejelasan peran dan bidang fokus.'
          : 'Fictional profiles that make roles and areas of focus clear.'
        : locale === 'id'
          ? 'Catatan contoh untuk membuka percakapan. Seluruh artikel fiktif dan bukan nasihat hukum.'
          : 'Example notes to begin a conversation. All articles are fictional and are not legal advice.'}
  </p>
</section>
<section class="legal-section">
  {kind === 'practices' && (
    <div class="legal-practice-index">
      {content.practices.map((practice) => (
        <article>
          <h2><a href={`${base}practices/${practice.slug}/`}>{practice.title}</a></h2>
          <p>{practice.intro}</p>
          <ul>
            {practice.work.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a class="legal-text-link" href={`${base}practices/${practice.slug}/`} aria-label={`${t.learn}: ${practice.title}`}>
            {t.learn} <ArrowUpRightIcon size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  )}
  {kind === 'people' && (
    <div class="legal-people-grid">
      {content.people.map((person) => (
        <article>
          <a href={`${base}people/${person.slug}/`} aria-label={`${t.profile}: ${person.name}`}>
            <DemoImage image={person.portrait} portrait alt={`${person.name} — ${t.synthetic}`} />
          </a>
          <span class="portrait-note">{t.synthetic}</span>
          <h2><a href={`${base}people/${person.slug}/`}>{person.name}</a></h2>
          <p class="legal-role">{person.role}</p>
          <p>{person.intro}</p>
          <a class="legal-text-link" href={`${base}people/${person.slug}/`} aria-label={`${t.profile}: ${person.name}`}>
            {t.profile} <ArrowUpRightIcon size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  )}
  {kind === 'insights' && (
    <div class="legal-article-grid">
      {content.articles.map((article) => (
        <article>
          <a href={`${base}insights/${article.slug}/`}>
            <DemoImage image={article.image} />
            <h2>{article.title}</h2>
          </a>
          <p>{article.intro}</p>
          <a class="legal-text-link" href={`${base}insights/${article.slug}/`} aria-label={`${t.learn}: ${article.title}`}>
            {t.learn} <ArrowUpRightIcon size={18} aria-hidden="true" />
          </a>
        </article>
      ))}
    </div>
  )}
</section>
