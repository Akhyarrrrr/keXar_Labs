---
import type { HeadquartersChapter } from '@/lib/headquarters';
interface Props {
  chapter: HeadquartersChapter;
  eager?: boolean;
  class?: string;
  opening?: boolean;
}
const { chapter, eager = false, class: className = 'hq-poster', opening = false } = Astro.props;
const desktop =
  opening && (chapter === 'arrival' || chapter === 'lobby')
    ? `/media/headquarters/opening/${chapter}.webp`
    : `/media/headquarters/posters/${chapter}-desktop.webp`;
---

<picture
  ><source
    media="(max-width: 700px)"
    srcset={`/media/headquarters/posters/${chapter}-mobile.webp`}
  /><img
    class={className}
    src={desktop}
    alt=""
    width="2560"
    height="1600"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
    decoding="async"
  /></picture
>
