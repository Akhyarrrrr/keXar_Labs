---
import { type Locale } from '@/lib/content';
import { GlobeExperience } from './globe-experience';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const id = locale === 'id';
---

<section class="globe-section section">
  <div class="center-intro">
    <h2>
      {id ? 'Jarak bukan batas untuk bekerja bersama.' : 'Good work travels beyond distance.'}
    </h2>
    <p>
      {id
        ? 'Dari percakapan pertama hingga peluncuran, kolaborasi tetap terhubung. Brief, prototype, dan setiap keputusan dapat ditinjau bersama secara digital.'
        : 'From the first conversation to launch, collaboration stays connected. Briefs, prototypes, and decisions can be reviewed together digitally.'}
    </p>
  </div>
  <GlobeExperience locale={locale} client:visible />
  <p class="globe-note">
    {id
      ? 'Visual koneksi ilustratif. Bukan penanda kantor atau lokasi klien.'
      : 'Illustrative connections. These do not represent offices or client locations.'}
  </p>
</section>
