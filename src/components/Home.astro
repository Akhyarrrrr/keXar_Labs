---
import { copy, type Locale } from '@/lib/content';
import HeroExperience from './HeroExperience.astro';
import { Gallery } from './gallery';
import { FAQ } from './faq';
import { CTA, Process, ServiceRows } from './ui';
import GlobeSection from './GlobeSection.astro';
import CraftSection from './CraftSection.astro';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = copy[locale];
---

<section class="home-hero">
  <HeroExperience />
  <div class="hero-copy">
    <h1>{t.headline}</h1>
    <p>{t.heroNote}</p>
    <div class="hero-actions">
      <CTA locale={locale} />
      <a href="#showcase" class="text-link">
        {t.explore}
        <svg
          width="18"
          height="18"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
          aria-hidden="true"
        >
          <path d="M12 4v16m-6-6 6 6 6-6" />
        </svg>
      </a>
    </div>
  </div>
  <div class="hero-bottom">
    <span>
      {locale === 'id'
        ? 'Website firma hukum. Dirancang dengan karakter.'
        : 'Law firm websites. Designed with character.'}
    </span>
    <span>Design / Development / Digital</span>
  </div>
</section>
<section class="section capability-section">
  <div>
    <h2>{t.capabilityTitle}</h2>
    <p class="lead">{t.capabilityNote}</p>
  </div>
  <div class="capability-list">
    {t.capabilities.map(([title, desc]) => (
      <article>
        <h3>{title}</h3>
        <p>{desc}</p>
      </article>
    ))}
  </div>
</section>
<Gallery locale={locale} home client:visible={{ rootMargin: '150px' }} />
<section class="section services-section">
  <div class="section-intro">
    <h2>{t.servicesTitle}</h2>
    <p>{t.servicesNote}</p>
  </div>
  <ServiceRows locale={locale} />
  <a class="text-link" href={`/${locale}/services/`}>
    {t.allServices}
    <svg
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      aria-hidden="true"
    >
      <path d="M6 18 18 6M6 6h12v12" />
    </svg>
  </a>
</section>
<GlobeSection locale={locale} />
<Process locale={locale} />
<FAQ locale={locale} client:visible={{ rootMargin: '800px' }} />
<CraftSection locale={locale} />
