---
import type { Locale } from '@/lib/content';
import { CTA } from './ui';
import { CraftExperience } from './craft-experience';
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const id = locale === 'id';
---

<section class="section craft-section" id="craft">
  <div class="craft-copy">
    <h2>
      {id
        ? 'Dibentuk dengan perhatian. Dari setiap sudut.'
        : 'Considered carefully. From every angle.'}
    </h2>
    <p>
      {id
        ? 'Putar bentuknya, ubah material, dan temukan bagaimana cahaya mengubah karakter. Perhatian yang sama kami bawa ke website Anda.'
        : 'Turn the form, change its material, and see how light shapes its character. We bring that same attention to your website.'}
    </p>
    <a class="text-link craft-jump" href="#portal-controls">
      {id ? 'Jelajahi detailnya' : 'Explore the craft'}
    </a>
    <CTA locale={locale} />
  </div>
  <CraftExperience locale={locale} client:visible={{ rootMargin: '300px' }} />
</section>
