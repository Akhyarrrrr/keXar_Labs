<div class="hero-visual" aria-hidden="true">
  <div class="hero-stage">
    <div class="hero-photo"></div>
  </div>
</div>

<script>
  const hero = document.querySelector<HTMLElement>('.home-hero');
  const stage = hero?.querySelector<HTMLElement>('.hero-stage');
  const reduced = matchMedia('(prefers-reduced-motion: reduce)');
  let x = 0,
    y = 0,
    frame = 0;
  const paint = () => {
    frame = 0;
    if (!hero || !stage) return;
    const progress = Math.min(
      1,
      Math.max(0, -hero.getBoundingClientRect().top / hero.offsetHeight),
    );
    stage.style.transform = reduced.matches
      ? 'none'
      : `translate3d(${x}px, ${y}px, 0) scale(${1.04 + progress * 0.1})`;
  };
  const schedule = () => {
    if (!frame) frame = requestAnimationFrame(paint);
  };
  hero?.addEventListener('pointermove', (event) => {
    if (reduced.matches || event.pointerType !== 'mouse') return;
    const bounds = hero.getBoundingClientRect();
    x = ((event.clientX - bounds.left) / bounds.width - 0.5) * -14;
    y = ((event.clientY - bounds.top) / bounds.height - 0.5) * -10;
    schedule();
  });
  hero?.addEventListener('pointerleave', () => {
    x = y = 0;
    schedule();
  });
  window.addEventListener('scroll', schedule, { passive: true });
  reduced.addEventListener('change', schedule);
  schedule();
</script>
