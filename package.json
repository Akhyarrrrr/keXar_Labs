{
  "name": "kexar-labs",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "astro build",
    "typecheck": "astro check && tsc -p tsconfig.worker.json --noEmit",
    "preview": "wrangler dev --port 8787",
    "cf:types": "wrangler types",
    "deploy:check": "node scripts/check-release.mjs",
    "deploy": "npm run deploy:check && npm run build && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/react": "7.0.1",
    "@phosphor-icons/react": "latest",
    "astro": "7.3.8",
    "oxc-transform-react": "^0.145.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "tailwindcss": "^4.1.0",
    "typescript": "latest",
    "wrangler": "4.149.0"
  }
}
